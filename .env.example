# انسخ الملف لـ .env واملأ القيم، أو حطها في إعدادات الاستضافة
ADMIN_PASSWORD=
# 32 حرف على الأقل: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# رقم الواتساب بصيغة دولية بدون +
WHATSAPP_PHONE=201149094108
# عنوان الموقع النهائي (بيُستخدم في معاينة الرابط على واتساب وفيسبوك)
SITE_URL=https://your-domain.com
DATA_DIR=./data
# اجعلها 1 لو السيرفر وراء Nginx أو Cloudflare
TRUST_PROXY=0
NODE_ENV=production
